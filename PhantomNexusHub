    "🚪 Home",
    "🏠 Main",
    "⚡ Exploits",
    "👁️ Visuals",
    "⚙️ Misc",
    "🔧 Setting",
    "📁 Archives",
    "🚪 Floor 2",
    "🌲 OutDoors",
    "⭐ Ekstra Menü"
}

-- Sağ İçerik Alanı
local ContentFrame = Instance.new("Frame")
ContentFrame.Size = UDim2.new(1, -155, 1, -55)
ContentFrame.Position = UDim2.new(0, 150, 0, 50)
ContentFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
ContentFrame.BorderSizePixel = 0
ContentFrame.Parent = MainFrame

local ContentCorner = Instance.new("UICorner")
ContentCorner.CornerRadius = UDim.new(0, 8)
ContentCorner.Parent = ContentFrame

local panels = {}

for _, tabName in ipairs(tabsList) do
    local TabButton = Instance.new("TextButton")
    TabButton.Size = UDim2.new(1, -5, 0, 30)
    TabButton.BackgroundColor3 = Color3.fromRGB(230, 240, 250)
    TabButton.BorderSizePixel = 0
    TabButton.Text = tabName
    TabButton.TextColor3 = Color3.fromRGB(0, 119, 182)
    TabButton.TextSize = 12
    TabButton.Font = Enum.Font.GothamBold
    TabButton.Parent = TabContainer
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = TabButton
    
    local Panel = Instance.new("ScrollingFrame")
    Panel.Size = UDim2.new(1, 0, 1, 0)
    Panel.BackgroundTransparency = 1
    Panel.Visible = false
    Panel.CanvasSize = UDim2.new(0, 0, 0, 400)
    Panel.ScrollBarThickness = 3
    Panel.Parent = ContentFrame
    
    local pLayout = Instance.new("UIListLayout")
    pLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pLayout.Padding = UDim.new(0, 8)
    pLayout.Parent = Panel
    
    panels[tabName] = Panel
    
    TabButton.MouseButton1Click:Connect(function()
        for _, p in pairs(panels) do p.Visible = false end
        Panel.Visible = true
        
        -- Ekstra Menü Tıklandığında Delta İçin Güvenli LinoriaLib Çağrısı
        if tabName == "⭐ Ekstra Menü" then
            task.spawn(function()
                local success, err = pcall(function()
                    local repo = 'https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/'
                    local Library = loadstring(game:HttpGet(repo .. 'Library.lua'))()
                    local ExtraWindow = Library:CreateWindow({
                        Title = 'Phantom Nexus | LinoriaLib Ekstra Menü',
                        Center = true,
                        AutoShow = true
                    })
                    local ExtraTab = ExtraWindow:AddTab('🛠️ Performans', 'tool')
                    local GroupBox = ExtraTab:AddLeftGroupbox('VPN & Lag Optimizasyonu')
                    
                    GroupBox:AddButton('Oyun Lagını Azalt (FPS Booster)', function()
                        for _, v in pairs(workspace:GetDescendants()) do
                            if v:IsA('BasePart') then
                                v.Material = Enum.Material.SmoothPlastic
                                v.CastShadow = false
                            end
                        end
                    end)
                    
                    GroupBox:AddToggle('Özel VPN Simülatörü', {
                        Text = 'Ping Düşürücü Aktif',
                        Default = false,
                        Callback = function(val)
                            print("VPN Durumu: ", val)
                        end
                    })
                end)
                if not success then
                    warn("LinoriaLib mobil ortamda yüklenemedi: ", err)
                end
            end)
        end
    end)
end

