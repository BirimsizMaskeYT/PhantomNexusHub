-- Hookmetamethod Altyapısı (Delta / Executor Uyumlu)
local oldNamecall
if getgenv().hookmetamethod and not oldNamecall then
    pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            return oldNamecall(self, unpack(args))
        end)
    end)
end

